@mode(host.dual)

# calc: the command-line front end. Parses the arguments, answers --help
# and --version, and runs the calculator; a usage error is status 2 and an
# uncaught exception status 1.
#
# Runtime: host.dual. Compiled into the native binary build/calc by
# `make build` and into the Wasm desktop package build/pkg by `make wasm`;
# `loup run source/main.loup` interprets the same code. `make parity` checks
# that the three lanes print the same results.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.calc import (run_calc);

# Parses argv, runs the calculator and returns the exit status.
pub func run(argv: list[string]): int {
    let parsed = parse_args(argv);
    if (parsed.is_err()) {
        printErr(APP_NAME + ": " + parsed.unwrap_err());
        printErr("Try '" + APP_NAME + " --help' for more information.");
        return EXIT_USAGE;
    }
    let opts = parsed.unwrap();

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_calc(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_FAILURE;
    }
}
