@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output and error messages.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_expression_succeeds(): void {
    expectEq(run(["1 + 2", "x = 3; x * x"]), EXIT_OK, "two expressions");
}

func test_failing_expression_is_status_1(): void {
    expectEq(run(["1 / 0"]), EXIT_FAILURE, "division by zero");
    expectEq(run(["1 +"]), EXIT_FAILURE, "syntax error");
}

func test_unknown_option_is_usage_error(): void {
    expectEq(run(["--bogus"]), EXIT_USAGE, "unknown option");
    expectEq(run(["-p", "0", "1"]), EXIT_USAGE, "bad precision");
}
