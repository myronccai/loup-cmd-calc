@mode(host.dual)

# calc's elementary functions, written in plain Loup arithmetic.
#
# Runtime: host.dual. Compiled into the native binary build/calc by
# `make build` and into the Wasm desktop package build/pkg by `make wasm`;
# `loup run source/main.loup` interprets the same code. `make parity` checks
# that the three lanes print the same results.
#
# The self-hosted interpreter behind `loup run` has no libm (`exp`, `log`,
# `sin`, ... from core.math are missing there), so calc computes them itself.
# Only +, -, *, /, comparisons and core.math's floor are used, which
# every lane (interpreter, native binary, Wasm) evaluates identically, so the
# three lanes agree bit for bit. Negation is written `0.0 - x` because unary
# minus on a variable traps in the Wasm lane.
#
# Structure: constants; classification and rounding (is_nan, is_inf,
# round_half_away, trunc, is_whole); exp (reduce by multiples of ln 2, then
# a Taylor series); ln (reduce to [sqrt(1/2), sqrt(2)), then the atanh
# series); sin, cos and tan (reduce to a quadrant and |r| <= pi/4, then a
# series); atan (reflect and shift into |x| <= tan(pi/8), then a series);
# pow_int and factorial. Each series stops once a term no longer changes
# the sum.

from core.math import (floor);

pub const PI: float = 3.141592653589793;
pub const E: float = 2.718281828459045;

const LN2_HI: float = 0.6931471803691238;
const LN2_LO: float = 1.9082149292705877e-10;
const LN10: float = 2.302585092994046;
const HALF_PI: float = 1.5707963267948966;
const QUARTER_PI: float = 0.7853981633974483;
# pi/2 split into three parts for argument reduction (Cody and Waite).
const PIO2_1: float = 1.5707963267341256;
const PIO2_2: float = 6.077100506303966e-11;
const PIO2_3: float = 2.0222662487111665e-21;
const TAN_PI_8: float = 0.41421356237309503;
const EXP_MAX: float = 709.782712893384;
const EXP_MIN: float = 0.0 - 745.2;

pub func is_nan(x: float): bool {
    return x != x;
}

# Whether x is +inf or -inf.
pub func is_inf(x: float): bool {
    return x == x and x - x != x - x;
}

pub func abs(x: float): float {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

# Nearest whole number, halves away from zero.
pub func round_half_away(x: float): float {
    if (is_nan(x) or is_inf(x)) {
        return x;
    }
    if (x < 0.0) {
        return 0.0 - round_half_away(0.0 - x);
    }
    let down = floor(x);
    if (x - down >= 0.5) {
        return down + 1.0;
    }
    return down;
}

pub func trunc(x: float): float {
    if (x < 0.0) {
        return 0.0 - floor(0.0 - x);
    }
    return floor(x);
}

pub func is_whole(x: float): bool {
    return !is_inf(x) and !is_nan(x) and floor(x) == x;
}

# x * 2^k, one exact doubling or halving at a time.
func scale2(x: float, k: int): float {
    var v = x;
    var n = k;
    while (n > 0) {
        v = v * 2.0;
        n -= 1;
    }
    while (n < 0) {
        v = v * 0.5;
        n += 1;
    }
    return v;
}

pub func exp(x: float): float {
    if (is_nan(x)) {
        return x;
    }
    if (x > EXP_MAX) {
        return 1.0 / 0.0;
    }
    if (x < EXP_MIN) {
        return 0.0;
    }
    # x = k*ln2 + r with |r| <= ln2/2.
    let k = round_half_away(x / (LN2_HI + LN2_LO));
    let r = (x - k * LN2_HI) - k * LN2_LO;
    # Taylor series of e^r.
    var sum = 1.0;
    var term = 1.0;
    var n = 1;
    while (n < 30) {
        term = term * r / (n as float);
        let next = sum + term;
        if (next == sum) {
            break;
        }
        sum = next;
        n += 1;
    }
    return scale2(sum, k as int);
}

# Natural logarithm of a positive, finite x.
pub func ln(x: float): float {
    if (is_nan(x) or is_inf(x)) {
        return x;
    }
    # x = m * 2^k with m in [sqrt(1/2), sqrt(2)).
    var m = x;
    var k = 0;
    while (m >= 1.4142135623730951) {
        m = m * 0.5;
        k += 1;
    }
    while (m < 0.7071067811865476) {
        m = m * 2.0;
        k -= 1;
    }
    # ln(m) = 2 * atanh(s) with s = (m - 1) / (m + 1).
    let s = (m - 1.0) / (m + 1.0);
    let s2 = s * s;
    var power = s;
    var sum = s;
    var n = 3;
    while (n < 80) {
        power = power * s2;
        let next = sum + power / (n as float);
        if (next == sum) {
            break;
        }
        sum = next;
        n += 2;
    }
    let kf = k as float;
    return (kf * LN2_HI + (2.0 * sum + kf * LN2_LO));
}

pub func log10(x: float): float {
    return ln(x) / LN10;
}

# The sine and cosine series for |r| <= pi/4.
func sin_series(r: float): float {
    let r2 = r * r;
    var term = r;
    var sum = r;
    var n = 1;
    while (n < 30) {
        term = 0.0 - term * r2 / (((2 * n) * (2 * n + 1)) as float);
        let next = sum + term;
        if (next == sum) {
            break;
        }
        sum = next;
        n += 1;
    }
    return sum;
}

func cos_series(r: float): float {
    let r2 = r * r;
    var term = 1.0;
    var sum = 1.0;
    var n = 1;
    while (n < 30) {
        term = 0.0 - term * r2 / (((2 * n - 1) * (2 * n)) as float);
        let next = sum + term;
        if (next == sum) {
            break;
        }
        sum = next;
        n += 1;
    }
    return sum;
}

# x = q*(pi/2) + r with |r| <= pi/4; returns r, and q mod 4 through quadrant().
func reduce_quadrant(x: float): float {
    let q = round_half_away(x / HALF_PI);
    return ((x - q * PIO2_1) - q * PIO2_2) - q * PIO2_3;
}

func quadrant(x: float): int {
    let q = round_half_away(x / HALF_PI);
    let m = q - 4.0 * floor(q / 4.0);
    return m as int;
}

pub func sin(x: float): float {
    if (is_nan(x) or is_inf(x)) {
        return 0.0 / 0.0;
    }
    let r = reduce_quadrant(x);
    let q = quadrant(x);
    if (q == 0) {
        return sin_series(r);
    }
    if (q == 1) {
        return cos_series(r);
    }
    if (q == 2) {
        return 0.0 - sin_series(r);
    }
    return 0.0 - cos_series(r);
}

pub func cos(x: float): float {
    if (is_nan(x) or is_inf(x)) {
        return 0.0 / 0.0;
    }
    let r = reduce_quadrant(x);
    let q = quadrant(x);
    if (q == 0) {
        return cos_series(r);
    }
    if (q == 1) {
        return 0.0 - sin_series(r);
    }
    if (q == 2) {
        return 0.0 - cos_series(r);
    }
    return sin_series(r);
}

pub func tan(x: float): float {
    return sin(x) / cos(x);
}

# The arctangent series for |x| <= tan(pi/8).
func atan_series(x: float): float {
    let x2 = x * x;
    var power = x;
    var sum = x;
    var n = 3;
    var sign = 0.0 - 1.0;
    while (n < 120) {
        power = power * x2;
        let next = sum + sign * power / (n as float);
        if (next == sum) {
            break;
        }
        sum = next;
        sign = 0.0 - sign;
        n += 2;
    }
    return sum;
}

pub func atan(x: float): float {
    if (is_nan(x)) {
        return x;
    }
    if (x < 0.0) {
        return 0.0 - atan(0.0 - x);
    }
    if (is_inf(x)) {
        return HALF_PI;
    }
    if (x > 1.0) {
        return HALF_PI - atan(1.0 / x);
    }
    if (x > TAN_PI_8) {
        return QUARTER_PI + atan_series((x - 1.0) / (x + 1.0));
    }
    return atan_series(x);
}

# base^n for a whole exponent, by repeated squaring.
pub func pow_int(base: float, n: float): float {
    if (n < 0.0) {
        return 1.0 / pow_int(base, 0.0 - n);
    }
    var result = 1.0;
    var b = base;
    var k = n;
    while (k > 0.0) {
        let half = floor(k / 2.0);
        if (k - 2.0 * half == 1.0) {
            result = result * b;
        }
        k = half;
        if (k > 0.0) {
            b = b * b;
        }
    }
    return result;
}

# n! for a whole n from 0; inf past 170!.
pub func factorial(n: float): float {
    if (n > 170.0) {
        return 1.0 / 0.0;
    }
    var result = 1.0;
    var k = 2.0;
    while (k <= n) {
        result = result * k;
        k = k + 1.0;
    }
    return result;
}
