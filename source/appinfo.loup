@mode(host.dual)

# calc: application identity and exit statuses. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/calc by
# `make build` and into the Wasm desktop package build/pkg by `make wasm`;
# `loup run source/main.loup` interprets the same code. `make parity` checks
# that the three lanes print the same results.

pub const APP_NAME: string = "calc";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "An expression calculator with variables and user-defined functions.";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
