@mode(host.dual)

# Command-line parsing for calc (`calc [OPTION]... [EXPRESSION]...`): argv
# to an Options record, or the message of a usage error.
#
# Runtime: host.dual. Compiled into the native binary build/calc by
# `make build` and into the Wasm desktop package build/pkg by `make wasm`;
# `loup run source/main.loup` interprets the same code. `make parity` checks
# that the three lanes print the same results.
#
# Options come before the first expression; `--` ends them. An argument that
# starts with `-` followed by a digit, `.` or `(` is an expression (`-2^2`),
# not an option. Every argument after the options is one line of input.
# parse_precision reads the digits itself: system.text's number parsers do
# not link in native builds of Loup 1.26.0.

pub const DEFAULT_PRECISION: int = 12;
pub const MAX_PRECISION: int = 17;

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub precision: int;
    pub exprs: list[string];
}

# Whether `arg` starts like a negative number or a parenthesis rather than
# an option.
pub func looks_like_expression(arg: string): bool {
    if (arg.len() < 2 or !arg.startsWith("-")) {
        return false;
    }
    return "0123456789.(".index_of(arg.slice(1, 2)) >= 0;
}

# The value of a decimal precision argument, or -1 when it is not a whole
# number from 1 to MAX_PRECISION.
pub func parse_precision(text: string): int {
    if (text.len() == 0 or text.len() > 2) {
        return -1;
    }
    var value = 0;
    for (ch in text) {
        let digit = "0123456789".index_of(ch);
        if (digit < 0) {
            return -1;
        }
        value = value * 10 + digit;
    }
    if (value < 1 or value > MAX_PRECISION) {
        return -1;
    }
    return value;
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var help = false;
    var version = false;
    var precision = DEFAULT_PRECISION;
    var exprs: list[string] = [];
    var options_done = false;

    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;

        if (options_done or arg == "-" or !arg.startsWith("-") or looks_like_expression(arg)) {
            options_done = true;
            exprs.push(arg);
            continue;
        }
        if (arg == "--") {
            options_done = true;
            continue;
        }

        if (arg == "-h" or arg == "--help") {
            help = true;
            continue;
        }
        if (arg == "-V" or arg == "--version") {
            version = true;
            continue;
        }

        # -p N, -pN, --precision N, --precision=N
        var value = "";
        var has_value = false;
        if (arg == "-p" or arg == "--precision") {
            if (i >= argv.len()) {
                return Err("option '" + arg + "' requires an argument");
            }
            value = argv[i];
            i += 1;
            has_value = true;
        } else if (arg.startsWith("--precision=")) {
            value = arg.slice(12);
            has_value = true;
        } else if (arg.startsWith("-p") and !arg.startsWith("--")) {
            value = arg.slice(2);
            has_value = true;
        }
        if (has_value) {
            let p = parse_precision(value);
            if (p < 0) {
                return Err("invalid precision '" + value + "' (expected 1 to 17)");
            }
            precision = p;
            continue;
        }

        return Err("unknown option '" + arg + "'");
    }

    return Ok(Options(
        help = help,
        version = version,
        precision = precision,
        exprs = exprs,
    ));
}
