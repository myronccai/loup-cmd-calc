@mode(host.dual)

# Unit tests for calc's number formatting (engine.format): whole numbers,
# rounding to the precision, scientific notation, nan and inf, and the
# decimal digits of a float.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the native
# binary or the Wasm package.

from debug.assert import (expectEq);
from engine.format import (format_number, to_decimal, round_decimal);

func test_whole_numbers(): void {
    expectEq(format_number(42.0, 12), "42", "integer");
    expectEq(format_number(-7.0, 12), "-7", "negative");
    expectEq(format_number(0.0, 12), "0", "zero");
    expectEq(format_number(0.0 - 0.0, 12), "0", "negative zero");
}

func test_rounding_to_precision(): void {
    expectEq(format_number(0.1 + 0.2, 12), "0.3", "0.1 + 0.2");
    expectEq(format_number(0.1 + 0.2, 17), "0.30000000000000004", "all digits");
    expectEq(format_number(1.0 / 3.0, 12), "0.333333333333", "1/3");
    expectEq(format_number(2.0 / 3.0, 12), "0.666666666667", "rounds up");
    expectEq(format_number(2.0 / 3.0, 3), "0.667", "3 digits");
    expectEq(format_number(9.9999999999999, 12), "10", "carry into a new digit");
}

func test_scientific_notation(): void {
    expectEq(format_number(123456789012.0, 12), "123456789012", "12 digits fit");
    expectEq(format_number(1234567890123.0, 12), "1.23456789012e+12", "13 digits do not");
    expectEq(format_number(1e21, 12), "1e+21", "large");
    expectEq(format_number(0.000001, 12), "0.000001", "1e-6 is plain");
    expectEq(format_number(0.0000001, 12), "1e-7", "1e-7 is scientific");
    expectEq(format_number(0.00000012345, 12), "1.2345e-7", "mantissa digits");
}

func test_special_values(): void {
    expectEq(format_number(1e308 * 10.0, 12), "inf", "inf");
    expectEq(format_number(-1e308 * 10.0, 12), "-inf", "-inf");
    expectEq(format_number(0.0 / 0.0, 12), "nan", "nan");
}

func test_decimal_digits(): void {
    let d = to_decimal(0.00125);
    expectEq(d.digits, "125", "digits");
    expectEq(d.point, -2, "point");
    let big = to_decimal(1500.0);
    expectEq(big.digits, "15", "trailing zeros dropped");
    expectEq(big.point, 4, "point");
    let r = round_decimal(to_decimal(0.999), 2);
    expectEq(r.digits, "1", "0.999 to 2 digits");
    expectEq(r.point, 1, "becomes 1");
}
