@mode(host.dual)

# calc's lexer: one line of input to a list of tokens. A `#` starts a
# comment that runs to the end of the line.
#
# Runtime: host.dual. Compiled into the native binary build/calc by
# `make build` and into the Wasm desktop package build/pkg by `make wasm`;
# `loup run source/main.loup` interprets the same code. `make parity` checks
# that the three lanes print the same results.
#
# Structure: the token types, character classes, number_value (the value of
# a decimal literal, computed here because system.text's float parser does
# not link natively and traps in Wasm), then tokenize: one left-to-right
# pass that takes the longest token at each position and ends the list with
# an End token one column past the line.

pub enum TokenKind {
    Number,
    Name,
    Op,
    LParen,
    RParen,
    Comma,
    Assign,
    Semi,
    End,
}

pub struct Token {
    pub kind: TokenKind;
    pub text: string;
    pub value: float;
    pub col: int;
}

# The tokens of a line, or a syntax error at a 1-based column. (A plain
# struct rather than a Result with a struct error: native builds of Loup
# 1.26.0 misread a struct inside Err when the Ok type is an enum.)
pub struct Lexed {
    pub tokens: list[Token];
    pub error: string;
    pub col: int;
}

const DIGITS: string = "0123456789";
const NAME_START: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
const SPACE: string = " \t\r";

func is_digit(ch: string): bool {
    return DIGITS.index_of(ch) >= 0;
}

func is_name_start(ch: string): bool {
    return NAME_START.index_of(ch) >= 0;
}

func is_name_char(ch: string): bool {
    return is_name_start(ch) or is_digit(ch);
}

func token(kind: TokenKind, text: string, col: int): Token {
    return Token(kind = kind, text = text, value = 0.0, col = col);
}

# 10^n for a whole n >= 0 (exact up to 10^22).
func power_of_ten(n: int): float {
    var result = 1.0;
    var k = 0;
    while (k < n) {
        result = result * 10.0;
        k += 1;
    }
    return result;
}

# The value of a decimal literal: up to 18 significant digits are kept as an
# integer mantissa, which is then scaled by a power of ten. The literal
# scanner below guarantees the shape `digits[.digits][e[+-]digits]`.
pub func number_value(text: string): float {
    var mantissa = 0;
    var kept = 0;
    var scale = 0;
    var seen_point = false;
    var exponent = 0;
    var exponent_negative = false;
    var in_exponent = false;
    for (ch in text) {
        if (in_exponent) {
            if (ch == "-") {
                exponent_negative = true;
            } else if (ch != "+" and exponent < 100000) {
                exponent = exponent * 10 + DIGITS.index_of(ch);
            }
        } else if (ch == "e" or ch == "E") {
            in_exponent = true;
        } else if (ch == ".") {
            seen_point = true;
        } else {
            let digit = DIGITS.index_of(ch);
            if (kept < 18) {
                if (mantissa > 0 or digit > 0) {
                    kept += 1;
                }
                mantissa = mantissa * 10 + digit;
                if (seen_point) {
                    scale -= 1;
                }
            } else if (!seen_point) {
                scale += 1;
            }
        }
    }
    if (exponent_negative) {
        scale -= exponent;
    } else {
        scale += exponent;
    }
    var value = mantissa as float;
    if (mantissa == 0) {
        return 0.0;
    }
    # Scale in steps of at most 10^22 so each step is one rounding.
    while (scale > 0) {
        let step = if (scale > 22) { 22 } else { scale };
        value = value * power_of_ten(step);
        scale -= step;
    }
    while (scale < 0) {
        let step = if (scale < 0 - 22) { 22 } else { 0 - scale };
        value = value / power_of_ten(step);
        scale += step;
    }
    return value;
}

pub func tokenize(line: string): Lexed {
    # The line as one-character strings, so the scanner can look ahead and
    # cut token text by index.
    var chars: list[string] = [];
    for (ch in line) {
        chars.push(ch);
    }
    let n = chars.len();
    var tokens: list[Token] = [];
    var i = 0;
    while (i < n) {
        let ch = chars[i];
        let col = i + 1;
        if (SPACE.index_of(ch) >= 0) {
            i += 1;
            continue;
        }
        if (ch == "#") {
            break;
        }

        # Numbers: digits[.digits][e[+-]digits], or .digits. An `e` with no
        # digits after it is not part of the number: `2e` is 2 and the name e.
        let next_is_digit = i + 1 < n and is_digit(chars[i + 1]);
        if (is_digit(ch) or (ch == "." and next_is_digit)) {
            var j = i;
            while (j < n and is_digit(chars[j])) {
                j += 1;
            }
            if (j < n and chars[j] == ".") {
                j += 1;
                while (j < n and is_digit(chars[j])) {
                    j += 1;
                }
            }
            if (j < n and (chars[j] == "e" or chars[j] == "E")) {
                var k = j + 1;
                if (k < n and (chars[k] == "+" or chars[k] == "-")) {
                    k += 1;
                }
                if (k < n and is_digit(chars[k])) {
                    while (k < n and is_digit(chars[k])) {
                        k += 1;
                    }
                    j = k;
                }
            }
            let text = chars.slice(i, j).join("");
            tokens.push(Token(kind = TokenKind.Number, text = text, value = number_value(text), col = col));
            i = j;
            continue;
        }

        if (is_name_start(ch)) {
            var j = i;
            while (j < n and is_name_char(chars[j])) {
                j += 1;
            }
            tokens.push(token(TokenKind.Name, chars.slice(i, j).join(""), col));
            i = j;
            continue;
        }

        # Two-character operators before one-character ones, so that `<=` is
        # not read as `<` followed by `=`.
        let pair = if (i + 1 < n) { ch + chars[i + 1] } else { ch };
        if (pair == "==" or pair == "!=" or pair == "<=" or pair == ">=") {
            tokens.push(token(TokenKind.Op, pair, col));
            i += 2;
            continue;
        }
        if ("+-*/%^!<>".index_of(ch) >= 0) {
            tokens.push(token(TokenKind.Op, ch, col));
        } else if (ch == "(") {
            tokens.push(token(TokenKind.LParen, ch, col));
        } else if (ch == ")") {
            tokens.push(token(TokenKind.RParen, ch, col));
        } else if (ch == ",") {
            tokens.push(token(TokenKind.Comma, ch, col));
        } else if (ch == "=") {
            tokens.push(token(TokenKind.Assign, ch, col));
        } else if (ch == ";") {
            tokens.push(token(TokenKind.Semi, ch, col));
        } else {
            return Lexed(tokens = tokens, error = "unexpected character '" + ch + "'", col = col);
        }
        i += 1;
    }
    tokens.push(token(TokenKind.End, "", n + 1));
    return Lexed(tokens = tokens, error = "", col = 0);
}
