@mode(host.dual)

# Number formatting: a result is rounded to a number of significant digits
# and printed in plain or scientific notation, like printf's %g.
#
# The digits come from str(x), the shortest decimal that reads back as x,
# which every lane produces identically; rounding is then done on the
# decimal digits, so no lane-specific float printing is involved.

from engine.mathlib import (is_nan, is_inf);

const DIGITS: string = "0123456789";

func digit_value(ch: string): int {
    return DIGITS.index_of(ch);
}

# Decimal digits and exponent of a positive finite x: x = 0.DIGITS * 10^point.
pub struct Decimal {
    pub digits: string;
    pub point: int;
}

pub func to_decimal(x: float): Decimal {
    let text = str(x);
    var mantissa = text;
    var exponent = 0;
    let e_at = text.index_of("e");
    if (e_at >= 0) {
        mantissa = text.slice(0, e_at);
        var rest = text.slice(e_at + 1);
        var negative = false;
        if (rest.startsWith("+")) {
            rest = rest.slice(1);
        } else if (rest.startsWith("-")) {
            rest = rest.slice(1);
            negative = true;
        }
        for (ch in rest) {
            exponent = exponent * 10 + digit_value(ch);
        }
        if (negative) {
            exponent = 0 - exponent;
        }
    }
    var int_part = mantissa;
    var frac_part = "";
    let dot = mantissa.index_of(".");
    if (dot >= 0) {
        int_part = mantissa.slice(0, dot);
        frac_part = mantissa.slice(dot + 1);
    }
    var digits = int_part + frac_part;
    var point = int_part.len() + exponent;
    while (digits.len() > 1 and digits.startsWith("0")) {
        digits = digits.slice(1);
        point -= 1;
    }
    while (digits.len() > 1 and digits.slice(digits.len() - 1) == "0") {
        digits = digits.slice(0, digits.len() - 1);
    }
    return Decimal(digits = digits, point = point);
}

# Rounds the digits to at most `precision` significant digits, half up.
pub func round_decimal(d: Decimal, precision: int): Decimal {
    if (d.digits.len() <= precision) {
        return d;
    }
    var values: list[int] = [];
    for (ch in d.digits.slice(0, precision)) {
        values.push(digit_value(ch));
    }
    var point = d.point;
    if (digit_value(d.digits.slice(precision, precision + 1)) >= 5) {
        var i = precision - 1;
        var carry = true;
        while (carry and i >= 0) {
            if (values[i] == 9) {
                values[i] = 0;
                i -= 1;
            } else {
                values[i] = values[i] + 1;
                carry = false;
            }
        }
        if (carry) {
            # 99...9 rounded up: 10...0, one place further left.
            return Decimal(digits = "1", point = point + 1);
        }
    }
    var parts: list[string] = [];
    for (v in values) {
        parts.push(DIGITS.slice(v, v + 1));
    }
    var digits = parts.join("");
    while (digits.len() > 1 and digits.slice(digits.len() - 1) == "0") {
        digits = digits.slice(0, digits.len() - 1);
    }
    return Decimal(digits = digits, point = point);
}

pub func format_number(x: float, precision: int): string {
    if (is_nan(x)) {
        return "nan";
    }
    if (is_inf(x)) {
        if (x > 0.0) {
            return "inf";
        }
        return "-inf";
    }
    if (x == 0.0) {
        return "0";
    }
    var sign = "";
    var magnitude = x;
    if (x < 0.0) {
        sign = "-";
        magnitude = 0.0 - x;
    }
    let d = round_decimal(to_decimal(magnitude), precision);
    let digits = d.digits;
    let n = digits.len();
    let exp10 = d.point - 1;

    if (exp10 < 0 - 6 or exp10 >= precision) {
        var text = digits.slice(0, 1);
        if (n > 1) {
            text = text + "." + digits.slice(1);
        }
        if (exp10 < 0) {
            return sign + text + "e-" + str(0 - exp10);
        }
        return sign + text + "e+" + str(exp10);
    }
    if (d.point <= 0) {
        return sign + "0." + "0".repeat(0 - d.point) + digits;
    }
    if (d.point >= n) {
        return sign + digits + "0".repeat(d.point - n);
    }
    return sign + digits.slice(0, d.point) + "." + digits.slice(d.point);
}
